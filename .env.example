# ==============================================
# DevMesh Environment Configuration Template
# ==============================================

# ----------------------------------------------
# Backend API (apps/api)
# ----------------------------------------------
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://devmesh:devmeshpassword@localhost:5432/devmesh
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_key_change_in_production
GITHUB_OAUTH_CLIENT_ID=your_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret

# ----------------------------------------------
# AI Provider Abstraction (OpenAI & Anthropic)
# ----------------------------------------------
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------------------------
# Collaboration Server (apps/collab)
# ----------------------------------------------
HOCUSPOCUS_PORT=1234
COLLAB_PERSISTENCE_DB=postgresql://devmesh:devmeshpassword@localhost:5432/devmesh

# ----------------------------------------------
# LiveKit WebRTC (Audio, Video, Screen Sharing)
# ----------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecretsecret

# ----------------------------------------------
# S3 / MinIO Object Storage (Recordings & Snapshots)
# ----------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=devmesh-recordings
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ----------------------------------------------
# Client Frontend (apps/client)
# ----------------------------------------------
VITE_API_URL=http://localhost:3001
VITE_COLLAB_WS_URL=ws://localhost:1234
VITE_LIVEKIT_URL=ws://localhost:7880
